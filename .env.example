# Copy to .env.local for local production-mode runs. Never commit real values.
# Dry runs (npm run scan -- --dry-run) need none of these.

# Long random string (32+ characters) that scopes all your data in Firestore.
# The same value goes in the dashboard link and in the GitHub secret SPACE_KEY.
SPACE_KEY=<SPACE_KEY>

FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>

# One of the two:
# Local: path to the service-account JSON file (keep it outside the repo).
GOOGLE_APPLICATION_CREDENTIALS=<PATH_TO_SERVICE_ACCOUNT_JSON>
# GitHub Actions: the JSON content itself, stored as a secret.
# FIREBASE_SERVICE_ACCOUNT=<SERVICE_ACCOUNT_JSON>

# Optional: where push notifications link to. Defaults to https://<project>.web.app
# DASHBOARD_URL=<DASHBOARD_URL>
